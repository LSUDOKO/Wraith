# Server-side only. The browser never talks to the extension proxy directly —
# the /api/info route relays it, because the proxy sets no CORS headers and its
# tunnel URL should not ship in a client bundle.
EXT_PROXY_URL=http://127.0.0.1:6674

# Deployed WraithOrders on Coston2.
NEXT_PUBLIC_WRAITH_ADDRESS=0xB52DC39e29e82a1cda5Bbc51BA3597c7EF8C43C6

# Asset escrowed by an order. Defaults to wrapped native (WC2FLR) when unset,
# because a tester can mint it from faucet C2FLR in one click. FXRP is the
# production asset but needs an FAssets agent and a minting flow — pointing at
# it with an empty wallet reverts with FAssetBalanceTooLow.
#   FXRP on Coston2: 0x0b6A3645c240605887a5532109323A3E12273dc7
NEXT_PUBLIC_FXRP_ADDRESS=0xC67DCE33D7A8efA5FfEB961899C73fe01bCe9273

# Asset a swap trigger buys.
NEXT_PUBLIC_TOKEN_OUT=0xC67DCE33D7A8efA5FfEB961899C73fe01bCe9273

# FTSO feed the trigger watches. Default is FLR/USD.
NEXT_PUBLIC_FEED_ID=0x01464c522f55534400000000000000000000000000

# Sentry error tracking
# Leave empty in local dev and CI to disable.
NEXT_PUBLIC_SENTRY_DSN=

# PostHog funnel analytics
# Leave empty in local dev and CI to disable.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# WalletConnect project id (https://cloud.reown.com). Unset hides the option.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
